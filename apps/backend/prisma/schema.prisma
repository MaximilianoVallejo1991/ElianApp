generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model Group {
  id            String       @id @default(cuid())
  name          String
  currency      String       @default("ARS")
  ownerId       String
  balanceMode   BalanceMode  @default(DYNAMIC)
  status        GroupStatus  @default(ACTIVE)

  inviteToken   String?      @unique
  inviteExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner               User                 @relation("GroupOwner", fields: [ownerId], references: [id])
  members             GroupMember[]
  expenses            Expense[]
  payments            Payment[]
  periods             Period[]
}

model User {
  id                 String   @id @default(cuid())

  name               String?
  lastName           String?
  nickName           String?  @unique

  email              String?  @unique
  hashedPassword     String

  passwordResetToken  String?
  passwordResetExpires DateTime?

  isActive           Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  groups             GroupMember[]

  ownedGroups        Group[]    @relation("GroupOwner")

  paidExpenses       Expense[] @relation("ExpensePayer")
  createdExpenses    Expense[] @relation("ExpenseCreator")

  sentPayments            Payment[]      @relation("PaymentSender")
  receivedPayments        Payment[]      @relation("PaymentReceiver")

  expenseSplits           ExpenseSplit[]
  expenseItems            ExpenseItem[] @relation("ExpenseItemUser")
}

model GroupMember {
  groupId  String
  userId   String
  status   MemberStatus @default(PENDING)

  joinedAt DateTime?
  isFrozen Boolean      @default(false)

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Period {
  id        String       @id @default(cuid())
  groupId   String
  status    PeriodStatus @default(OPEN)
  isCurrent Boolean      @default(false)
  startedAt DateTime     @default(now())
  closedAt  DateTime?
  createdAt DateTime     @default(now())

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenses Expense[]
  payments Payment[]

  @@index([groupId])
  @@index([groupId, status])
  @@index([groupId, isCurrent])
}

model Payment {
  id         String   @id @default(cuid())

  groupId    String

  fromUserId String
  toUserId   String

  amount     Decimal

  method     String?

  paidAt     DateTime @default(now())

  deletedAt  DateTime?

  status          PaymentStatus @default(PENDING)
  rejectionReason String?

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  period      Period?  @relation(fields: [periodId], references: [id], onDelete: SetNull)
  periodId    String?

  fromUser    User @relation("PaymentSender", fields: [fromUserId], references: [id])

  toUser      User @relation("PaymentReceiver", fields: [toUserId], references: [id])
}

enum ExpenseCategory {
  FOOD
  DRINKS
  TRANSPORT
  HOUSING
  ENTERTAINMENT
  GIFTS
  OTHER
}

enum ExpenseSplitType {
  EQUAL
  PERCENTAGE
  COLLECTIVE
}

enum BalanceMode {
  DYNAMIC
  STATIC
}

enum GroupStatus {
  ACTIVE
  CLOSED
}

enum ExpenseStatus {
  PENDING
  MISMATCH
  COMPLETED
}

enum MemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum PeriodStatus {
  OPEN
  CLOSING
  CLOSED
  FINAL
}

enum PaymentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Expense {
  id          String   @id @default(cuid())

  groupId     String

  payerId     String
  createdById String

  description String?

  amount      Decimal

  date        DateTime @default(now())

  category    ExpenseCategory
  splitType   ExpenseSplitType

  status      ExpenseStatus @default(COMPLETED)
  isLocked    Boolean       @default(true)
  sharedCosts Decimal?      @default(0)
  participantIds String[]   @default([])

  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  period      Period?      @relation(fields: [periodId], references: [id], onDelete: SetNull)
  periodId    String?

  payer       User @relation("ExpensePayer", fields: [payerId], references: [id])

  createdBy   User @relation("ExpenseCreator", fields: [createdById], references: [id])

  splits      ExpenseSplit[]
  items       ExpenseItem[]
}

model ExpenseSplit {
  id          String   @id @default(cuid())

  expenseId   String
  userId      String

  amount      Decimal?
  percentage  Decimal?

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model ExpenseItem {
  id          String   @id @default(cuid())
  expenseId   String
  userId      String
  amount      Decimal
  description String?  @default("mi gasto")
  dateReported DateTime @default(now())
  createdAt   DateTime @default(now())

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation("ExpenseItemUser", fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}