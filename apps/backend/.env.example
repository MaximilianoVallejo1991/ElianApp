# JWT - generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-secret"

# Resend - email service (https://resend.com)
# Get your API key from the Resend dashboard
RESEND_API_KEY="re_..."
EMAIL_FROM="ElianApp <noreply@yourdomain.com>"